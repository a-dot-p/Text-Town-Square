{{if and (not .Values) (not .ExecData) (not .StrippedID)}} {{ephemeralResponse}} Menu reset. {{deleteResponse 1}} {{return}} {{end}}
{{$op := 0}}
{{$TSmsg := .Message}}
{{$gc := .Channel.ID}}
{{if .Channel.IsThread}} {{$gc = .Channel.ParentID}} {{end}}
{{$roles := (dbGet $gc "roleInfo").Value}}

{{if .ExecData}} {{/* slash command shortcuts */}}
	{{$op = .ExecData}}
	{{$TSmsg = (getMessage $gc ($roles.Get "mid"))}}
	{{if not $TSmsg}} {{ephemeralResponse}} Please send this in your game channel. {{return}} {{end}}
{{else}}
	{{$op = toInt64 (index .Values 0)}}
{{end}}

{{$isST := hasRole ($roles.Get "stRole")}}
{{if and (not $isST) (in (cslice 5 6 7 8 9 13 14 16) $op)}}
	{{ephemeralResponse}} You are not an ST. {{return}}
{{end}}
{{$desc := (structToSdict (index $TSmsg.Embeds 0)).Description}}
{{if eq $op 1}} {{/*NOMINATE*/}}
	{{$menu := cmenu "type" "user" "custom_id" "nomMenu" "required" true}}	
	{{$ti := ctextInput "custom_id" "accusation" "style" 2}}
	{{$l2 := clabel "label" "Add accusation" "component" $ti}}
	{{$l1 := clabel "label" "Select a nominee" "component" $menu}}
	{{$mb := modalBuilder "text-nom" "Nominate" $l1 $l2}}
	{{sendModal $mb}}
{{else if eq $op 2}} {{/*START WHISPER*/}}
	{{$menu := cmenu "type" "user" "custom_id" "whisperMenu" "required" true "max_values" 5}}	
	{{$ti := ctextInput "custom_id" "whispname"}}
	{{$l1 := clabel "label" "Select who you want to whisper" "component" $menu}}
	{{$l2 := clabel "label" "(Optional) Whisper thread name" "component" $ti}}
	{{$mb := modalBuilder "text2-whisper" "Whisper" $l1 $l2}}
	{{sendModal $mb}}
{{else if eq $op 3}} {{/* SET STATUS*/}}
	{{$menu := cmenu "type" "user" "custom_id" "statusMenu"}}
	{{$l1 := clabel "label" "(ST) only: adjust someone else's status" "component" $menu}}
	{{$rg := cradioGroup "custom_id" "statusMenu" "options" (cslice 
      	(sdict "label" "alive" "value" "0" "default" true)
		(sdict "label" "dead" "value" "1")
 		(sdict "label" "dead (without vote token)" "value" "2"))}}
	{{$l2 := clabel "label" "Select a status for yourself" "component" $rg}}
    {{$mb := modalBuilder "text-status" "Set Status" $l1 $l2}}
    {{sendModal $mb}}
{{else if eq $op 4}} {{/* JOIN/LEAVE */}}
	{{$numSeats := len (reFindAll `\*\d+` $desc)}}
	{{$options := cslice}}
	{{range $numSeats}}
		{{$options = $options.Append (sdict "label" (str (add 1 .)) "value" (str (add 1 .) ))}}
	{{end}}
	{{$menu := cmenu "type" "text" "placeholder" "Choose a seat" "custom_id" "seatMenu" "options" $options "required" true}}
	{{$ti := ctextInput "custom_id" "gamenickname" "style" 1}}
	{{$l2 := clabel "label" "Name to put on the seat" "component" $ti "description" "leave blank if leaving"}}
	{{$l1 := clabel "label" "Seat to Join/Leave" "component" $menu}}
    {{$mb := modalBuilder "text-joinleave" "Join/Leave Game" $l1 $l2}}
    {{sendModal $mb}}
{{else if eq $op 5}} {{/* NOM THREAD */}}
	{{$ti := ctextInput "custom_id" "nomthreadname" "style" 1 "placeholder" "e.g. Day 2 Nominations" "required" true}}
	{{$ti2 := ctextInput "custom_id" "cname" "style" 1}}
	{{$l1 := clabel "label" "Nomination Thread Name" "component" $ti}}
	{{$l2 := clabel "label" "Edit Channel Name" "component" $ti2}}
	{{$mb := modalBuilder "text-threadNom" "Nominate" $l1 $l2}}
	{{sendModal $mb}}
{{else if eq $op 6}} {{/* KIBITZ/CO-ST */}}
	{{$menu := cmenu "type" "user" "custom_id" "kib" "max_values" 10}}	
	{{$menu2 := cmenu "type" "user" "custom_id" "cost"}}	
	{{$l1 := clabel "label" "KIBITZ: who to add or remove (up to 10)" "component" $menu}}
	{{$l2 := clabel "label" "CO-ST: who to add or remove" "component" $menu2}}
	{{$mb := modalBuilder "text2-kibitz" "Add/Remove Kibitz" $l1 $l2}}
	{{sendModal $mb}}
{{else if eq $op 7}} {{/* SET REMINDER */}}
	{{$ti := ctextInput "custom_id" "setreminder" "style" 1 "required" true "placeholder" "e.g. 12"}}
	{{$ti2 := ctextInput "custom_id" "setreminderMsg" "style" 1 "required" true "placeholder" "e.g. Noms & whispers close"}}
	{{$ti3 := ctextInput "custom_id" "setremindertotal" "style" 1 "required" true "placeholder" "e.g. 24"}}
	{{$l3 := clabel "label" "Remind players that ___ hours are left" "component" $ti "description" "please resubmit this per each reminder you want to go out"}}
	{{$l1 := clabel "label" "Remind message" "component" $ti2}}	
	{{$l2 := clabel "label" "Total time in hours" "component" $ti3}}	
	{{$mb := modalBuilder "text2-setreminder" "Set Player Reminder" $l1 $l2 $l3 }}
	{{sendModal $mb}}
{{else if eq $op 8}} {{/* SEND TO THREADS */}}
	{{$ti := ctextInput "custom_id" "sendtoall" "style" 2 "required" true "placholder" "Markdown supported"}}
	{{$l := clabel "label" "Message to send" "component" $ti}}
	{{$mb := modalBuilder "text-sendtoall" "Send to ST Threads" $l}}
	{{sendModal $mb}}
{{else if eq $op 9}} {{/* START GAME */}}
	{{$cb := ccheckbox "custom_id" "starttextgame"}}
	{{$l := clabel "label" "I am ready to start the game." "component" $cb}}
	{{$mb := modalBuilder "text-start" "Start" $l}}
	{{sendModal $mb}}
{{else if eq $op 13}} {{/* END GAME */}}
	{{$ti := ctextInput "custom_id" "endTTS" "style" 1 "required" true "placeholder" "CONFIRM"}}	
	{{$l := clabel "label" "Please type CONFIRM to end the game." "component" $ti}}
	{{$mb := modalBuilder "text2-endgame" "Are you sure?" $l}}
	{{sendModal $mb}}
{{else if eq $op 14}} {{/* SEND CHARS */}}
	{{$ti := ctextInput "custom_id" "sendCH" "style" 2 "required" true "placeholder" "Imp\nEmpath\n..."}}	
	{{$cb := ccheckbox "custom_id" "spoiler"}}
	{{$menu := cmenu "type" "channel" "custom_id" "kibC" "required" true}}	
	{{$l1 := clabel "label" "Characters, one per line" "component" $ti "description" "use official spelling. These will be shuffled then sent."}}
    {{$l2 := clabel "label" "Spoiler character name & image?" "component" $cb}}
    {{$l3 := clabel "label" "Kibitz channel to send characters list" "component" $menu}}
    {{$mb := modalBuilder "text2-sendchars" "Send Characters" $l1 $l2 $l3}}
	{{sendModal $mb}}
{{else if eq $op 15}} {{/* JSON */}}
	{{$players := cslice}}
	{{range $y := (dbGet $gc "townSq").Value}}
		{{range $id, $nick := $y}}
			{{$players = $players.Append (sdict "name" $nick)}}
		{{end}}
	{{end}}
	{{$main := sdict "bluffs" (cslice "null" "null" "null") "edition" (sdict "id" "tb") "players" $players}}
	{{$msg := complexMessage "file" (json $main) "filename" "Game State JSON" "ephemeral" true}}
	{{sendResponse nil $msg}}
{{else if eq $op 16}} {{/* ADD/REMOVE */}}
	{{$numSeats := len (reFindAll `\*\d+` $desc)}}
	{{$options := cslice}}
	{{range $numSeats}}
		{{$options = $options.Append (sdict "label" (str (add 1 .)) "value" (str (add 1 .) ))}}
	{{end}}
	{{$menu := cmenu "type" "text" "placeholder" "Choose a seat" "custom_id" "seatMenu" "options" $options}}
	{{$rg := cradioGroup "custom_id" "addr" "options" (cslice 
      	(sdict "label" "add" "value" "1")
		(sdict "label" "remove" "value" "-1")) "required" true}}
	{{$menu2 := cmenu "type" "user" "custom_id" "addRM" "required" true}}
	{{$l1 := clabel "label" "User" "component" $menu2}}
	{{$l2 := clabel "label" "Add or remove?" "component" $rg}}
	{{$l3 := clabel "label" "Seat to add user AFTER" "component" $menu "description" "if removing, leave blank"}}
	{{$mb := modalBuilder "text-addremove" "Add/Remove" $l1 $l2 $l3}}
	{{sendModal $mb}}
{{end}}
{{dbSet $gc "modalsCCID" .CCID}}
