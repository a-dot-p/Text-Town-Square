{{$I := .StrippedID}}
{{$cd := .Channel.ID}}
{{if .Channel.IsThread}} 
	{{$cd = .Channel.ParentID}} 
{{end}}
{{$roles := (dbGet $cd "roleInfo").Value}}
{{$emoji := (dbGet 7 "ttsEmoji").Value}}
{{$sh := "🪦"}} {{$vt := "🗳️"}}
{{if $emoji}} {{$sh = $emoji.Get "shroud"}} {{$vt = $emoji.Get "voteToken"}} {{end}}
 
{{if eq $I "vote"}}
	{{$embed := index .Interaction.Message.Embeds 0}}
	{{$sdict := structToSdict $embed}}
	{{$desc := $sdict.Description}}
	{{$content := .Message.Content}}
	{{$vote := index .Values 0}}
	{{$p := index .Values 1}}
	{{$uid := str .User.ID}}
	{{$name := (dbGet $cd "townSq").Value}}
	{{range $x := $name}}
		{{if $x.Get $uid}} 
			{{$name = $x.Get $uid}}
		{{end}}
	{{end}}
	{{$name = print `**` $name `**`}}
	{{if not $p}}
		{{$desc = reReplace (printf "%s\n.*" (reQuoteMeta $name) ) $desc (printf "%s\n*%s*" $name $vote)}}
		{{$sdict.Set "description" $desc}}
		{{$msg := complexMessageEdit "embed" $sdict "content" $content}}
		{{editMessage nil .Interaction.Message.ID $msg}}
		{{$vh := (dbGet $cd "vhist").Value}}
		{{$vhMsg := (printf "**%s** voted `%s`\non %s" .User.Username $vote .Message.Link)}}
		{{if not $vh}}
			{{$vh = createThread $cd nil "Vote History"}}
			{{$vh = $vh.ID}}
			{{dbSet $cd "vhist" (str $vh)}}
			{{sendMessageNoEscape $vh (mentionRole ($roles.Get "pRole"))}}
		{{end}}
		{{sendMessage $vh $vhMsg}} 
	{{else}}
		{{$db := dbGet $cd .Interaction.Message.ID}}
		{{$val := sdict}}
		{{if $db}} {{$val = $db.Value}} {{end}}
		{{$val.Set .Member.Nick $vote}}
		{{dbSet $cd .Interaction.Message.ID $val}}
		{{$btn := cbutton "label" "Send to ST Thread" "custom_id" "textButtons-pv" "style" "success"}}
		{{$ct := (printf "**Your private vote:**\n%s" $vote)}} 
        {{$resp := complexMessage "content" $ct "buttons" $btn}}
        {{sendResponse nil $resp}}
		{{return}}
	{{end}}
	Voted for this nomination.
{{else if eq $I "adddefense"}}
	{{$content := .Message.Content}}
	{{$us := reFindAllSubmatches `<@(\d+)>` $content}}
	{{$nominatorID := index (index $us 0) 1}}
	{{$nomineeID := index (index $us 1) 1}}
	{{$u := str .User.ID}}
	{{if eq $u $nominatorID}} {{/*acc*/}}
		{{$content = reReplace `(?s)sation.*\*Defense` $content (printf "sation:** %s\n\n**Defense" (index .Values 0)) }}	
	{{else if eq $u $nomineeID}} {{/*def*/}}
		{{$content = reReplace `(?s)Defense:.*` $content (printf "Defense:** %s" (index .Values 0)) }}	
	{{else}} You are not the nominator or nominee. {{return}} {{end}}
 	{{$message := complexMessageEdit "content" $content}}
	{{editMessage nil .Interaction.Message.ID $message}}
	Nomination updated.
{{else if eq $I "countvotes"}}
	{{$embed := index .Interaction.Message.Embeds 0}}
	{{$sdict := structToSdict $embed}}
	{{$desc := $sdict.Description}}
	{{$result := index .Values 0}}
	{{$rx := (printf `(%s\s)?(%s\s)?.+\n.+` $sh $vt)}}
	{{$votes := reFindAll $rx $desc}}
	{{$indVotes := split $result ";"}}
	{{if not (eq (len $indVotes) (len $votes))}}
		Number of votes sent does not match player count.
	{{return}}
	{{end}}
	
	{{$iterations := (len $votes) }}
	{{$j := 0}}
	{{$val := ""}}
	{{$finalVotes := cslice}}
	{{range $iterations}}
		{{$val = index $indVotes $j}}
		{{$val = toInt64 $val}}
		{{if eq $val 1}}
			{{$finalVotes = $finalVotes.Append "✅"}}
		{{else if eq $val 0}}
			{{$finalVotes = $finalVotes.Append "❌"}}
		{{else if gt $val 1}}
			{{$finalVotes = $finalVotes.Append (print "✅ **" $val "**")}}
    	{{else if lt $val 0}}
           	{{$finalVotes = $finalVotes.Append (print "➖ " "**" $val "**") }}
		{{end}}
		{{$j = add 1 $j}}
	{{end}}
 
	{{$k := 0}}
	{{$editVotes := ""}}
	{{range $votes}}
		{{$symbol := index $finalVotes $k}}
		{{$change := reReplace "\n.*" . (printf "\n%s" $symbol) }}
		{{$editVotes = joinStr "\n\n" $editVotes $change}}
		{{$k = add 1 $k}}
	{{end}}
	{{$sdict.Set "description" $editVotes}}
	{{$message := complexMessageEdit "content" .Message.Content "embed" $sdict}}
	{{editMessage nil .Interaction.Message.ID $message}}
	Succesfully counted votes.
{{else if eq $I "endgame"}}
	{{$embed := index .Interaction.Message.Embeds 0}}
	{{$sdict := structToSdict $embed}}
	{{$desc := $sdict.Description}}
	{{if not (eq (index .Values 0) "CONFIRM")}}
		Did not type CONFIRM correctly.
	{{return}}
	{{end}}
	{{$pRole := $roles.Get "pRole"}}
	{{$names := cslice.AppendSlice (reFindAll .User.Mention $desc)}}
	{{range $names}}
		{{takeRole . $pRole}}
	{{end}}
	{{removeRole ($roles.Get "stRole")}}
	{{$x := dbDelMultiple (sdict "userID" .Interaction.ChannelID) 100 0}}
	Ended the text game & deleted all data. Contact a mod/admin to start a new one.
{{else if eq $I "whisper"}}
	{{$us := index .Values 0}}
	{{$name := index .Values 1}} 
	{{if not $name}}
		{{range $us}}
			{{$nick := (getMember .).Nick}}
			{{$name = joinStr " + " $name $nick}}
		{{end}}
		{{$name = joinStr " + " $name .Member.Nick}}
	{{end}}
	{{$thread := createThread nil nil $name true 10080 true}}
	{{range $us}}
   		{{addThreadMember $thread.ID .}}
	{{end}}
   	{{addThreadMember $thread.ID .User.ID}}
	Created whisper.
{{else if eq $I "kibitz"}}
	{{$members := index .Values 0}} 
	{{$kibRole := $roles.Get "kibRole"}}
	{{$added := ""}} {{$removed := ""}}
	{{range $members}}
		{{$x := getMember . }}
  		{{if targetHasRole . $kibRole}}
      		{{takeRole . $kibRole}}
			{{$removed = print $removed $x.Nick ", "}}
		{{else}}
			{{giveRole . $kibRole}}
			{{$added = print $added $x.Nick ", "}}
		{{end}}
  	{{end}}
	Added {{$added}} to kibitz & removed {{$removed}} from kibitz. 
{{else if eq $I "setreminder"}}
	{{$msg := index .Values 0}}
	{{$total := toFloat (index .Values 1)}}
	{{$delay := toFloat (index .Values 2)}}
	{{$delay = sub $total $delay}}
	{{$delay = mult $delay 3600}}
	{{$futureTime := add currentTime.Unix (mult $total 3600)}}
	{{$sendTime := printf "<t:%d:t>" (add currentTime.Unix $delay)}}
	{{$msg = printf "%s <t:%d:R>" $msg $futureTime}}
	{{$pRole := $roles.Get "pRole"}}
	{{$ccid := $roles.Get "ccid"}}
	{{$data := sdict "hours" (index .Values 2) "msg" $msg "role" $pRole}}
	{{$key := randInt 10000 100000}}
	{{if eq (toInt64 $delay) 0}} 	
		{{execCC $ccid $cd $delay $data}} 
 	{{else}}
		{{scheduleUniqueCC $ccid $cd $delay $key $data}} 
	{{end}}
	{{$menu := cmenu "type" "channel" "custom_id" "textButtons-r"}}	
	{{$button := cbutton "custom_id" (printf "textButtons%d" $key) "label" "Cancel Reminder" "style" "danger"}}
	{{$c := printf "Set the following reminder: **%s**\n(goes out at %s)\n\n*Send a copy to kibitz below:*" $msg $sendTime}}
	{{$rsp := complexMessage "content" $c "menus" $menu "buttons" $button}}
	{{sendResponse nil $rsp}}
{{else if eq $I "sendchars"}}
	{{$chars := index .Values 0}}
	{{$chars = cslice.AppendSlice (split $chars "\n")}}
	{{$chars = shuffle $chars}}
	{{$sp := index .Values 1}}
	{{$channel := index (index .Values 2) 0}} 
	{{$townSq := (dbGet $cd "townSq").Value}}
	{{$threads := (dbGet $cd "stthreads").Value}}
	{{if not (eq (len $threads) (len $chars))}} Character count does not match player count. {{return}} {{end}}
	{{$i := 0}}
	{{$list := cslice}}
	{{$name := ""}}
	{{range $uid, $id := $threads}}
		{{$c := index $chars $i}}
		{{$c2 := reReplace `\s` $c ``}}
		{{$c2 = lower $c2}}
		{{$b := componentBuilder}}
		{{$img := (printf "https://images.klutzbanana.com/characters_official/%s.png" $c2)}}
		{{if $sp}} {{$c = print "||" $c "||"}} {{end}}
		{{$sec := sdict "text" (print "**You are the**\n## " $c) "thumbnail" (sdict "media" $img "spoiler" $sp)}}
		{{$cont := componentBuilder}}
		{{$b.Add "section" $sec}}
		{{$cont.Add "container" (sdict "components" $b)}}
		{{sendMessage $id $cont}}
		{{range $j, $t := $townSq}}
			{{if $t.Get $uid}}
				{{$name = $t.Get $uid}}
				{{$name = (printf "**%d)** %s" (add $j 1) $name)}}
			{{end}}
		{{end}}
		{{$list = $list.Append (print $name ": " (index $chars $i))}}
		{{$i = add 1 $i}}
	{{end}}
	{{$list = sort $list}}
	{{$msg := joinStr "\n" $list}}
	{{sendMessage $channel $msg}}
	Succesfully sent characters.
{{else if eq $I "seevotes"}}
	{{$embed := index .Interaction.Message.Embeds 0}}
	{{$sdict := structToSdict $embed}}
	{{$desc := $sdict.Description}}
	{{$kib := index (index .Values 0) 0}} 
	{{$privateVotes := dbGet $cd .Message.ID}} 
	{{$pv := "-# no private votes found for this nomination"}}
	{{if $privateVotes}}
		{{$pv = "**Private Votes:**"}}
			{{range $nick, $vote := $privateVotes.Value}}
				{{$pv = joinStr "\n" $pv (printf "%s - %s" $nick $vote)}}
			{{end}}
	{{end}}
	{{sendMessage $kib (componentBuilder "container" (sdict "color" 13870849 "components"
    (componentBuilder "text" $pv "separator" true "text" $desc)))}} Sent.
{{end}}
