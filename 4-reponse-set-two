{{$I := .StrippedID}}
{{$roles := (dbGet .Channel.ID "roleInfo").Value}}
{{$desc := ""}}
{{if not (.Channel.IsThread)}}
	{{$TSmsg := getMessage nil ($roles.Get "mid")}}
	{{$embed := index $TSmsg.Embeds 0}}
	{{$sdict := structToSdict $embed}}
	{{$desc = $sdict.Description}}
	{{$content := $TSmsg.Content}}
{{end}}
{{if eq $I "vote"}}
	{{$embed := index .Interaction.Message.Embeds 0}}
	{{$sdict := structToSdict $embed}}
	{{$desc := $sdict.Description}}
	{{$content := .Message.Content}}
	{{$mainChannel := .Channel.ParentID}}
	{{$vote := index .Values 0}}
	{{$p := index .Values 1}}
	{{$uid := str .User.ID}}
	{{$name := (dbGet $mainChannel "townSq").Value}}
	{{range $x := $name}}
		{{if $x.Get $uid}} 
			{{$name = $x.Get $uid}}
		{{end}}
	{{end}}
	{{if not $p}}
		{{$desc = reReplace (printf "%s\n.*" $name) $desc (printf "%s\n*%s*" $name $vote)}}
		{{$sdict.Set "description" $desc}}
		{{$msg := complexMessageEdit "embed" $sdict "content" $content}}
		{{editMessage nil .Interaction.Message.ID $msg}}
	{{else}}
		{{if not ($db := dbGet $mainChannel .Interaction.Message.ID)}}
			{{$val := sdict .Member.Nick $vote}}
			{{dbSet $mainChannel .Interaction.Message.ID $val}}
		{{else}}
			{{$val := $db.Value}}
			{{$val.Set .Member.Nick $vote}}
			{{dbSet $mainChannel .Interaction.Message.ID $val}}
		{{end}}
		**Your private vote:** {{$vote}} {{return}}
	{{end}}
	Voted for this nomination.
{{else if eq $I "adddefense"}}
	{{$content := .Message.Content}}
	{{$us := reFindAllSubmatches `<@(\d+)>` $content}}
	{{$nominatorID := index (index $us 0) 1}}
	{{$nomineeID := index (index $us 1) 1}}
	{{$u := str .User.ID}}
	{{if eq $u $nominatorID}} {{/*acc*/}}
		{{$content = reReplace `(?s)sation.*\*Defense` $content (printf "sations:** %s\n\n**Defense" (index .Values 0)) }}	
	{{else if eq $u $nomineeID}} {{/*def*/}}
		{{$content = reReplace `(?s)Defense:.*` $content (printf "Defense:** %s" (index .Values 0)) }}	
	{{else}} You are not the nominator or nominee. {{return}} {{end}}
 	{{$message := complexMessageEdit "content" $content}}
	{{editMessage nil .Interaction.Message.ID $message}}
	Nomination updated.
{{else if eq $I "countvotes"}}
	{{$embed := index .Interaction.Message.Embeds 0}}
	{{$sdict := structToSdict $embed}}
	{{$desc := $sdict.Description}}
	{{$result := index .Values 0}}
	{{$votes := reFindAll `(🪦\s)?(🗳️\s)?.+\n.+` $desc}}
	{{$indVotes := split $result ";"}}
	{{if not (eq (len $indVotes) (len $votes))}}
		Number of votes sent does not match player count.
	{{return}}
	{{end}}
	
	{{$iterations := (len $votes) }}
	{{$j := 0}}
	{{$val := ""}}
	{{$finalVotes := cslice}}
	{{range $iterations}}
		{{$val = index $indVotes $j}}
		{{$val = toInt64 $val}}
		{{if eq $val 1}}
			{{$finalVotes = $finalVotes.Append "✅"}}
		{{else if eq $val 0}}
			{{$finalVotes = $finalVotes.Append "❌"}}
		{{else if gt $val 1}}
			{{$finalVotes = $finalVotes.Append (print "✅ **" $val "**")}}
    	{{else if lt $val 0}}
           	{{$finalVotes = $finalVotes.Append (print "➖ " "**" $val "**") }}
		{{end}}
		{{$j = add 1 $j}}
	{{end}}
 
	{{$k := 0}}
	{{$editVotes := ""}}
	{{range $votes}}
		{{$symbol := index $finalVotes $k}}
		{{$change := reReplace "\n.*" . (printf "\n%s" $symbol) }}
		{{$editVotes = joinStr "\n\n" $editVotes $change}}
		{{$k = add 1 $k}}
	{{end}}
	{{$sdict.Set "description" $editVotes}}
	{{$message := complexMessageEdit "content" .Message.Content "embed" $sdict}}
	{{editMessage nil .Interaction.Message.ID $message}}
	Succesfully counted votes.
{{else if eq $I "endgame"}}
	{{if not (eq (index .Values 0) "CONFIRM")}}
		Did not type CONFIRM correctly.
	{{return}}
	{{end}}
	{{$pRole := $roles.Get "pRole"}}
	{{$names := cslice.AppendSlice (reFindAll .User.Mention $desc)}}
	{{range $names}}
		{{takeRole . $pRole}}
	{{end}}
	{{removeRole ($roles.Get "stRole")}}
	{{$x := dbDelMultiple (sdict "userID" .Interaction.ChannelID) 100 0}}
	Ended the text game & deleted all data. Contact a mod/admin to start a new one.
{{else if eq $I "whisper"}}
	{{$us := index .Values 0}}
	{{$name := index .Values 1}} 
	{{if not $name}}
		{{range $us}}
			{{$nick := (getMember .).Nick}}
			{{$name = joinStr " + " $name $nick}}
		{{end}}
	{{end}}
	{{$thread := createThread nil nil $name true 10080 true}}
	{{range $us}}
   		{{addThreadMember $thread.ID .}}
	{{end}}
   	{{addThreadMember $thread.ID .User.ID}}
	Created whisper.
{{else if eq $I "kibitz"}}
	{{$members := index .Values 0}} 
	{{$kibRole := $roles.Get "kibRole"}}
	{{$added := ""}} {{$removed := ""}}
	{{range $members}}
		{{$x := getMember . }}
  		{{if targetHasRole . $kibRole}}
      		{{takeRole . $kibRole}}
			{{$removed = print $removed $x.Nick ", "}}
		{{else}}
			{{giveRole . $kibRole}}
			{{$added = print $added $x.Nick ", "}}
		{{end}}
  	{{end}}
	Added {{$added}} to kibitz & removed {{$removed}} from kibitz. 
{{else if eq $I "setreminder"}}
	{{$msg := index .Values 0}}
	{{$total := toFloat (index .Values 1)}}
	{{$delay := toFloat (index .Values 2)}}
	{{$delay = sub $total $delay}}
	{{$delay = mult $delay 3600}}
	{{$futureTime := add currentTime.Unix (mult $total 3600)}}
	{{$msg = printf "%s <t:%d:R>" $msg $futureTime}}
	{{$pRole := $roles.Get "pRole"}}
	{{$ccid := $roles.Get "ccid"}}
	{{$data := sdict "hours" (index .Values 2) "msg" $msg "role" $pRole}}
	{{execCC $ccid nil $delay $data}} 
	Set the following reminder: **{{$msg}}**
(goes out in {{div $delay 3600}} hours).
{{else if eq $I "sendchars"}}
	{{$chars := index .Values 0}}
	{{$chars = cslice.AppendSlice (split $chars "\n")}}
	{{$chars = shuffle $chars}}
	{{$sp := index .Values 1}}
	{{$channel := index (index .Values 2) 0}} 
	{{$townSq := (dbGet .Channel.ID "townSq").Value}}
	{{$threads := (dbGet .Channel.ID "stthreads").Value}}
	{{if not (eq (len $threads) (len $chars))}} Character count does not match player count. {{return}} {{end}}
	{{$i := 0}}
	{{$list := cslice}}
	{{$name := ""}}
	{{range $uid, $id := $threads}}
		{{$c := index $chars $i}}
		{{$c2 := reReplace `\s` $c ``}}
		{{$c2 = lower $c2}}
		{{$b := componentBuilder}}
		{{$img := (printf "https://images.klutzbanana.com/characters_official/%s.png" $c2)}}
		{{if $sp}} {{$c = print "||" $c "||"}} {{end}}
		{{$sec := sdict "text" (print "**You are the**\n## " $c) "thumbnail" (sdict "media" $img "spoiler" $sp)}}
		{{$cont := componentBuilder}}
		{{$b.Add "section" $sec}}
		{{$cont.Add "container" (sdict "components" $b)}}
		{{sendMessage $id $cont}}
		{{range $townSq}}
			{{if .Get $uid}}
				{{$name = .Get $uid}}
			{{end}}
		{{end}}
		{{$list = $list.Append (print $name ": " (index $chars $i))}}
		{{$i = add 1 $i}}
	{{end}}
	{{$msg := joinStr "\n" $list}}
	{{sendMessage $channel $msg}}
	Succesfully sent characters.
{{end}}
