{{$I := .StrippedID}}
{{$gc := .Channel.ID}}
{{if .Channel.IsThread}}
	{{$gc = .Channel.ParentID}} 
{{end}}
{{$roles := (dbGet $gc "roleInfo").Value}}
{{$TSmsg := getMessage $gc ($roles.Get "mid")}}
{{$embed := index $TSmsg.Embeds 0}}
{{$sdict := structToSdict $embed}}
{{$desc := $sdict.Description}}

{{if eq $I "joinleave"}}
	{{if dbGet $gc "townSq"}} 
		The game has already started! 
		{{return}}
	{{end}}
	{{$st := (index $sdict.Fields 1).Value}} 
	{{$threads := (dbGet $gc "stthreads").Value}}
	{{$playerRole := $roles.Get "pRole"}}
	{{$seat := index (index .Values 0) 0}}
	{{$nick := index .Values 1}}
	{{$ex := print `\*\*` $seat `\).+`}}
	{{$uid := str .User.ID}}
	{{if reFind .User.Mention $desc}} {{/*LEAVE*/}}
		{{$repl := print `**` $seat `)** ` `<empty seat>`}}
		{{$desc = reReplace $ex $desc $repl}}
		{{deleteThread ($threads.Get $uid)}}
		{{$threads.Del $uid}}
		{{dbSet $gc "stthreads" $threads}}
		{{removeRole $playerRole}}
		Left the game.	
	{{else}}
		{{$r1 := (print `\*\*` $seat `\)\*\* <emp`)}}
		{{if not (reFind $r1 $desc)}} This seat is taken! {{return}} {{end}} 
		{{if not $nick}} Please enter a name. {{return}} {{end}}
		{{$repl := print `**` $seat `)** ` $nick " " .User.Mention}}
		{{$desc = reReplace $ex $desc $repl}}
		{{$th := createThread nil nil (print "ST - " $nick) true 10080 true}}
		{{addThreadMember $th.ID .User.ID}} {{addThreadMember $th.ID $st}}
		{{if not $threads}}
			{{$threads = sdict $uid (str $th.ID)}}
		{{else}}
			{{$threads.Set $uid (str $th.ID)}}
		{{end}}
		{{dbSet $gc "stthreads" $threads}}
		{{addRole $playerRole}}
		Joined the game.
	{{end}}
{{else if eq $I "start"}}
	{{if not ($sdict.Get "Fields")}} 
	The game has already started! {{return}} {{end}}
	{{$players := cslice.AppendSlice (reFindAllSubmatches `\s([\w\-.\s<>]+)\s<@(\d+)>` $desc)}}
	{{$desc = " "}}
	{{$townSq := cslice}}
	{{range $j, $x := $players}}
		{{$j = add 1 $j}}
		{{$id := index $x 2}}
		{{$nick := index $x 1}}
		{{$x = index $x 0}}
		{{$current := print "**" $j ")** " $x}}
		{{$desc = joinStr "\n\n" $desc $current}}
		{{$info := sdict $id $nick}}
		{{$townSq = $townSq.Append $info}} 
	{{end}}
	{{$desc = reReplace `(\n\n)$` $desc ``}}
	{{$sdict.Del "Fields"}}
	The game has started with the above players.
	{{dbSet $gc "townSq" $townSq}}
{{else if eq $I "threadNom"}}
	{{$name := index .Values 0}}
	{{$threadNoms := createThread nil nil $name}} {{addThreadMember $threadNoms.ID .User}}
	{{dbSet $gc "threadNom" (str $threadNoms.ID)}} 
	Created thread.
{{else if eq $I "nom"}}
	{{$nomThread := (dbGet $gc "threadNom").Value}}
	{{if not $nomThread}} Today's nomination thread was not made by the ST yet.
	{{return}} {{end}}
	{{$nomineeID := index (index .Values 0) 0}}
	{{$accu := index .Values 1}}
	{{$players := (dbGet $gc "townSq").Value}}
	{{$numPlayers := len $players}} 
	{{$nomineeURL := (getMember $nomineeID).User.AvatarURL "64"}}
	{{$textRole := $roles.Get "pRole"}}	
	{{$tsNames := cslice.AppendSlice (reFindAll `.+` $desc)}}
	{{$startIndex := 0}}
	{{$i := 0}}
	{{$ps := cslice}}
	{{$nominator := ""}} {{$nominee := ""}}
	{{$uid := str .User.ID}}
	{{range $pl := $players}}
		{{if $pl.Get $uid}}
			{{$nominator = $pl.Get $uid}}
		{{end}}
		{{if $pl.Get $nomineeID}}
			{{$nominee = $pl.Get $nomineeID}}
		{{end}}
		{{range $id, $nick := $pl}}
			{{if eq $id $nomineeID }}
        		{{$startIndex = add $i 1}} 
    		{{end}} 	
			{{if reFind "🗳️" (index $tsNames $i)}}
				{{$ps = $ps.Append (printf "🪦 🗳️ %s" $nick)}} 
			{{else if reFind "🪦" (index $tsNames $i)}}
				{{$ps = $ps.Append (printf "🪦 %s" $nick)}} 
			{{else}}
				{{$ps = $ps.Append $nick}} 
			{{end}} 
		{{end}}
		{{$i = add 1 $i}}
	{{end}}
	{{$votes := cslice}}
	{{range $j := (seq 0 $numPlayers)}}
		{{$k := (toInt (mod (add $startIndex $j) $numPlayers))}}
		{{$voter := index $ps $k}}
    	{{$votes = $votes.Append $voter}}
	{{end}}
	{{$votes = joinStr "\n...\n\n" $votes}}
	{{$votes = joinStr "\n" $votes "..."}}
	{{$opts := (cslice 
	(sdict "label" "Vote" "value" "10" "description" "vote for this nomination, including privately")
   	(sdict "label" "Edit Nomination" "value" "11" "description" "add a defense or edit accusation")
   	(sdict "label" "(ST) count votes" "value" "12" "description" "count votes & finalize nomination"))}}
	{{$menu := cmenu "type" "text" "placeholder" "Choose an action" "options" $opts "custom_id" "textButtons" "min_values" 0 }}
	{{$embed := (cembed "title" "Votes" "description" $votes "color" 13870849 "author" (sdict "icon_url" (.User.AvatarURL "256") "name" .Member.Nick)
    "thumbnail" (sdict "url" $nomineeURL))}}
	{{sendMessageNoEscape $nomThread (complexMessage
	"content" (printf "<@&%s>\n<@%s> nominates <@%s>!\n\n**Accusation:** %s\n\n**Defense:** ..." $textRole $uid $nomineeID $accu) "menus" $menu                     "embed" $embed)}}
	Nomination made in thread.
{{else if eq $I "status"}}
	{{$strole := $roles.Get "stRole"}}
	{{$target := index .Values 0}} 
	{{$user := .User.Mention}}
	{{if and ($target) (hasRole $strole)}}
		{{$user = print "<@" (index $target 0) ">"}}
	{{else if $target}}
		You are not authorized to change someone's status. 
		{{return}}
	{{end}}
	{{$op := index .Values 1}} 
	{{$status := ""}}
	{{$sh := `🪦`}}
	{{$shr := print `(\s` $sh `)?`}}
	{{$vt := `🗳️`}}
	{{$vtr := print `(\s` $vt `)?`}}
	{{$ex := print $shr $vtr `([\w\-.\s<>]+\s` $user `)`}} 
	{{if eq $op "0"}}
		{{$desc = reReplace $ex $desc `${3}`}}
		{{$status = "alive."}}
	{{else if eq $op "1"}}
		{{$desc = reReplace $ex $desc (print ` ` $sh ` ` $vt `${3}`)}}
       	{{$status = "dead."}}
	{{else}}
		{{$desc = reReplace $ex $desc (print ` ` $sh `${3}`)}}
		{{$status = "dead without a vote token."}}
	{{end}}
	Set status to {{$status.}}
{{else if eq $I "sendtoall"}}
	{{$msg := index .Values 0}}
	{{$msg = print "### " $msg}}
	{{$threads := (dbGet $gc "stthreads").Value}}
	{{$embed := (cembed "author" (sdict
		"icon_url" (.User.AvatarURL "256")
		"name" .Member.Nick)
		"color" 13870849
		"description" $msg)}}
	{{$m := complexMessage "embed" $embed}}
	{{range $players, $tID := $threads}}
		{{sendMessage $tID $m}}
	{{end}}
	Sent message to all ST threads.
{{end}}
{{$sdict.Set "description" $desc}}
{{$msg := complexMessageEdit "embed" $sdict}}
{{editMessage $gc $TSmsg.ID $msg}}
